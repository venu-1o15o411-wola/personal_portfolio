# Local SQLite (default). For production on Vercel, use Turso:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=...
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Required in production. Used to sign the admin session cookie.
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_PASSWORD=changeme

# OpenAI — used to match Upwork job descriptions to case studies.
OPENAI_API_KEY=

# Vercel Blob — leave empty locally; uploads go to /public/uploads.
# On Vercel, create a Blob store and this is injected automatically.
BLOB_READ_WRITE_TOKEN=

# Shown on client share pages
PORTFOLIO_NAME=Adrian
PORTFOLIO_TITLE=Independent engineer
PORTFOLIO_TAGLINE=Selected work, prepared for this role.

# Optional. Used when copying share URLs from the server.
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
