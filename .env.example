# Supabase Postgres — Project → Connect → URI.
# Use Session pooler (port 5432, host *.pooler.supabase.com). NOT db.xxx.supabase.co.
# User must be postgres.<project-ref>. Encode special characters in the password (! → %21).
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Optional. Transaction pooler (port 6543) is better on Vercel; keep session URI above for db:seed.
# DIRECT_DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase API — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional. Defaults to project-media (created as a public bucket on first upload).
# SUPABASE_STORAGE_BUCKET=project-media

# Required in production. Used to sign the admin session cookie.
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_PASSWORD=changeme

# OpenAI — used to match Upwork job descriptions to case studies.
OPENAI_API_KEY=

# Shown on client share pages
PORTFOLIO_NAME=Adrian
PORTFOLIO_TITLE=Independent engineer
PORTFOLIO_TAGLINE=Selected work, prepared for this role.

# Optional. Used when copying share URLs from the server.
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
